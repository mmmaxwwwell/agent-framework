#!/usr/bin/env bash
# secret-intake: get a secret from the operator without it passing through
# the agent's chat, a terminal, a command line or a log. See SKILL.md.
#
#   secret-intake cloudflare-url --name <token name> --perm <key>:<read|edit> [--perm ...]
#                                --account <account id> [--zone <zone id>]
#       Opens Cloudflare's create-token form with the permissions filled in.
#
#   secret-intake paste --prompt <text> [--verify cloudflare|none] [--pattern <regex>]
#                       [--recipient <age pubkey>]... [--recipients-file <age -R file>]
#                       --to age:<file> | --to exec:<command> [--to ...]
#       Rofi password box on the operator's screen. The value is checked
#       (pattern, then the optional verify) and handed to every --to:
#         age:<file>     encrypted to the recipients, written atomically
#         exec:<command> run by bash with the value on stdin (no newline)
#       Prints statuses only. Escape in the box = cancelled, nothing written.
#
# Exit: 0 done, 1 cancelled / refused / a sink failed, 2 usage.
set -euo pipefail
umask 077

die() { printf 'secret-intake: %s\n' "$1" >&2; exit "${2:-1}"; }
usage() { sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

cmd=${1:-}
[ -n "$cmd" ] || usage
shift

case "$cmd" in
  cloudflare-url)
    name="" account="" zone="" perms=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --name) name=${2:?}; shift 2 ;;
        --perm) perms+=("${2:?}"); shift 2 ;;
        --account) account=${2:?}; shift 2 ;;
        --zone) zone=${2:?}; shift 2 ;;
        *) usage ;;
      esac
    done
    [ -n "$name" ] && [ -n "$account" ] && [ "${#perms[@]}" -gt 0 ] || usage
    for p in "${perms[@]}"; do
      [[ $p =~ ^[a-z0-9_]+:(read|edit)$ ]] || die "--perm $p: want <key>:<read|edit>" 2
    done
    keys=$(printf '%s\n' "${perms[@]}" | jq -cRn '[inputs | split(":") | {key: .[0], type: .[1]}]')
    url="https://dash.cloudflare.com/profile/api-tokens?permissionGroupKeys=$(jq -rn --arg k "$keys" '$k|@uri')&accountId=$account&zoneId=${zone:-all}&name=$(jq -rn --arg n "$name" '$n|@uri')"
    (xdg-open "$url" >/dev/null 2>&1 &)
    printf 'opened the create-token form (%s)\n' "${perms[*]}"
    ;;

  paste)
    prompt="" verify=none pattern='^[^[:space:]]+$' sinks=() recips=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --prompt) prompt=${2:?}; shift 2 ;;
        --verify) verify=${2:?}; shift 2 ;;
        --pattern) pattern=${2:?}; shift 2 ;;
        --recipient) recips+=(-r "${2:?}"); shift 2 ;;
        --recipients-file) recips+=(-R "${2:?}"); shift 2 ;;
        --to) sinks+=("${2:?}"); shift 2 ;;
        *) usage ;;
      esac
    done
    [ -n "$prompt" ] && [ "${#sinks[@]}" -gt 0 ] || usage
    case "$verify" in cloudflare) pattern='^[A-Za-z0-9_-]{20,}$' ;; none) ;; *) die "--verify $verify: cloudflare or none" 2 ;; esac
    for s in "${sinks[@]}"; do
      case "$s" in
        age:?*) [ "${#recips[@]}" -gt 0 ] || die "age sink needs --recipient or --recipients-file" 2 ;;
        exec:?*) ;;
        *) die "--to $s: want age:<file> or exec:<command>" 2 ;;
      esac
    done

    # rofi -mesg is Pango markup: escape it.
    msg=${prompt//&/&amp;}; msg=${msg//</&lt;}; msg=${msg//>/&gt;}
    secret=$(rofi -dmenu -password -l 0 -p secret -mesg "$msg (Escape cancels)" </dev/null) \
      || die "cancelled (Escape); nothing written"
    secret=${secret//[$'\n\r']/}
    [ -n "$secret" ] || die "nothing entered; nothing written"
    [[ $secret =~ $pattern ]] || die "that does not look right (pattern $pattern); nothing written"

    if [ "$verify" = cloudflare ]; then
      # The token reaches curl through a /dev/fd pipe, never argv.
      resp=$(curl -sS --proto =https --max-time 30 \
        -K <(printf 'header = "Authorization: Bearer %s"\n' "$secret") \
        https://api.cloudflare.com/client/v4/user/tokens/verify) || die "could not reach Cloudflare; nothing written"
      jq -e '.success and .result.status == "active"' >/dev/null <<<"$resp" \
        || die "Cloudflare does not accept it ($(jq -c '.errors' <<<"$resp")); nothing written"
      echo "verified with Cloudflare: active"
    fi

    rc=0
    for s in "${sinks[@]}"; do
      case "$s" in
        age:*)
          f=${s#age:}
          mkdir -p "$(dirname "$f")"
          if printf '%s' "$secret" | age "${recips[@]}" -o "$f.new" && mv "$f.new" "$f"; then
            echo "saved encrypted: $f"
          else rm -f "$f.new"; echo "FAILED: age:$f"; rc=1; fi ;;
        exec:*)
          if printf '%s' "$secret" | bash -c "${s#exec:}"; then echo "ok: ${s#exec:}"
          else echo "FAILED: ${s#exec:}"; rc=1; fi ;;
      esac
    done
    unset secret
    exit "$rc"
    ;;

  *) usage ;;
esac
